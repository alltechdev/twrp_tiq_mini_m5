# Android fstab for TWRP on the Tiq M5 (MT6761), based on the stock fstab.mt6761.
#<src>                         <mnt_point>      <type> <mnt_flags and options>                                                       <fs_mgr_flags>
system                          /system_root     ext4   ro                                                                            wait,logical,first_stage_mount,slotselect
vendor                          /vendor          ext4   ro                                                                            wait,logical,first_stage_mount,slotselect
product                         /product         ext4   ro                                                                            wait,logical,first_stage_mount,slotselect

/dev/block/by-name/md_udc       /metadata        ext4   noatime,nosuid,nodev,discard                                                  wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata     /data            ext4   noatime,nosuid,nodev,noauto_da_alloc,errors=panic,inlinecrypt                 latemount,wait,check,quota,reservedsize=128M,formattable,resize,checkpoint=block,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption

/dev/block/by-name/boot         /boot            emmc   defaults                                                                      slotselect
/dev/block/by-name/dtbo         /dtbo            emmc   defaults                                                                      slotselect
/dev/block/by-name/vbmeta       /vbmeta          emmc   defaults                                                                      slotselect
/dev/block/by-name/vbmeta_system /vbmeta_system  emmc   defaults                                                                      slotselect
/dev/block/by-name/vbmeta_vendor /vbmeta_vendor  emmc   defaults                                                                      slotselect
/dev/block/by-name/para         /misc            emmc   defaults                                                                      defaults
