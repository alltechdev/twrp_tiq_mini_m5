# TWRP-only partitions and display flags (merged with recovery.fstab)
#<mnt_point>     <type> <src>                                    <flags>
/system_image    emmc   /dev/block/mapper/system                 flags=display="System Image";backup=1;flashimg=1;slotselect
/vendor_image    emmc   /dev/block/mapper/vendor                 flags=display="Vendor Image";backup=1;flashimg=1;slotselect
/product_image   emmc   /dev/block/mapper/product                flags=display="Product Image";backup=1;flashimg=1;slotselect

/boot            emmc   /dev/block/by-name/boot                  flags=display="Boot";backup=1;flashimg=1;slotselect
/dtbo            emmc   /dev/block/by-name/dtbo                  flags=display="DTBO";backup=1;flashimg=1;slotselect
/vbmeta          emmc   /dev/block/by-name/vbmeta                flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system   emmc   /dev/block/by-name/vbmeta_system         flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/vbmeta_vendor   emmc   /dev/block/by-name/vbmeta_vendor         flags=display="VBMeta Vendor";backup=1;flashimg=1;slotselect
/lk              emmc   /dev/block/by-name/lk                    flags=display="LK";backup=1;flashimg=1;slotselect
/logo            emmc   /dev/block/by-name/logo                  flags=display="Logo";backup=1;flashimg=1
/md1img          emmc   /dev/block/by-name/md1img                flags=display="Modem";backup=1;flashimg=1;slotselect

/nvram           emmc   /dev/block/by-name/nvram                 flags=display="NVRAM";backup=1;flashimg=1
/nvdata          ext4   /dev/block/by-name/nvdata                flags=display="NVDATA";backup=1
/nvcfg           ext4   /dev/block/by-name/nvcfg                 flags=display="NVCFG";backup=1
/protect_f       ext4   /dev/block/by-name/protect1              flags=display="Protect_f";backup=1
/protect_s       ext4   /dev/block/by-name/protect2              flags=display="Protect_s";backup=1
/proinfo         emmc   /dev/block/by-name/proinfo               flags=display="Proinfo";backup=1;flashimg=1
/seccfg          emmc   /dev/block/by-name/seccfg                flags=display="Seccfg";backup=1

/external_sd     auto   /dev/block/mmcblk1p1  /dev/block/mmcblk1 flags=display="MicroSD";storage;wipeingui;removable
/usb_otg         auto   /dev/block/sda1       /dev/block/sda     flags=display="USB OTG";storage;wipeingui;removable
